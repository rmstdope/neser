{
	admin off
	auto_https off
}

:8080 {
	root * /srv
	encode zstd gzip
	header {
		Cache-Control "no-store"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
	}
	handle /healthz {
		respond "ok" 200
	}
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle {
		file_server
	}
}
