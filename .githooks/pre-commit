#!/bin/sh
# Pre-commit hook: auto-format staged Rust and Python files.
#
# If any .rs files are staged, cargo fmt is run; if any .py files are staged,
# ruff format is run on them (.venv/bin/ruff first, then ruff on PATH; with
# neither the commit is refused). The originally staged files are re-staged with
# the formatted content.
#
# NOTE: If you staged only a partial hunk (git add -p), re-staging the
# formatted file will include any unstaged changes in that file too.
# In that case, review the staged diff after the commit with git show HEAD.

# rustup's cargo proxy exports RUSTUP_TOOLCHAIN to every process it starts, so a shell opened from
# anything launched with `cargo run` (the Cerebro fleet view, for one) inherits `stable`, which
# beats rust-toolchain.toml. Unset it so this runs on the pinned toolchain, as CI does.
unset RUSTUP_TOOLCHAIN

run_bd_hook() {
    # beads (bd init) installs its own hooks under .beads/hooks; chain to them so the board
    # keeps working while core.hooksPath stays on .githooks for the auto-format step above.
    if [ -x "$(git rev-parse --show-toplevel)/.beads/hooks/pre-commit" ]; then
        exec "$(git rev-parse --show-toplevel)/.beads/hooks/pre-commit" "$@"
    fi
    exit 0
}
staged_rs=$(git diff --cached --name-only --diff-filter=ACMR | grep '\.rs$')
staged_py=$(git diff --cached --name-only --diff-filter=ACMR | grep '\.py$')

if [ -z "$staged_rs" ] && [ -z "$staged_py" ]; then
    run_bd_hook "$@"
fi

if [ -n "$staged_rs" ]; then
    echo "Running cargo fmt on staged Rust files..."
    cargo fmt
    fmt_exit=$?

    if [ $fmt_exit -ne 0 ]; then
        echo "cargo fmt failed (exit $fmt_exit). Aborting commit."
        exit 1
    fi

    # Re-stage the originally staged .rs files so formatting changes are included.
    echo "$staged_rs" | xargs git add
fi

if [ -n "$staged_py" ]; then
    # Fleet sessions never activate the venv, so look in this worktree's own .venv first (the
    # gate calls .venv/bin/python the same way), then on PATH. With neither, refuse the commit:
    # skipping only moves the failure to the gate's `ruff format --check`.
    ruff_bin="$(git rev-parse --show-toplevel)/.venv/bin/ruff"
    if [ ! -x "$ruff_bin" ]; then
        ruff_bin=$(command -v ruff)
    fi
    if [ -z "$ruff_bin" ]; then
        echo "ERROR: ruff not found (looked for $(git rev-parse --show-toplevel)/.venv/bin/ruff and on PATH);"
        echo "       refusing to commit unformatted Python."
        echo "       Install it with: pip install --group scripts/pyproject.toml:dev"
        exit 1
    fi

    echo "Running ruff format on staged Python files..."
    echo "$staged_py" | xargs "$ruff_bin" format --quiet
    fmt_exit=$?

    if [ $fmt_exit -ne 0 ]; then
        echo "ruff format failed (exit $fmt_exit). Aborting commit."
        exit 1
    fi

    echo "$staged_py" | xargs git add
fi

run_bd_hook "$@"
